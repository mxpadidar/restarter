environment=dev
app_name=restarter
app_version=0.1.0
django_secret=change-me
django_allowed_hosts=["localhost", "127.0.0.1"]
log_level="INFO"
hmac_secret=replace-with-a-different-random-secret-at-least-32-characters
jwt_secret=replace-with-a-random-secret-at-least-32-characters
jwt_issuer=drf-starter
jwt_audience=drf-starter-api
jwt_leeway_seconds=30
